---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Divyansh",
  description = "Notes on software, learning, and things I find interesting.",
} = Astro.props;
const pageTitle = title === "Divyansh" ? title : `${title} | Divyansh`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Divyansh" href="/rss.xml" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>D</text></svg>" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <a class="site-name" href="/">Divyansh</a>
        <a href="/about">About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Divyansh</p>
    </footer>
  </body>
</html>
