---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (
  await getCollection(
    "blog",
    ({ id, data }) => id.startsWith("my-career/") && !data.draft,
  )
).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

<BaseLayout
  title="My Career"
  description="Stories and lessons from my professional experience."
>
  <section class="intro">
    <h1>My Career</h1>
    <p>Stories and lessons from my professional experience.</p>
  </section>

  {
    posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <time datetime={post.data.published.toISOString()}>
              {formatDate(post.data.published)}
            </time>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p>No My Career posts yet.</p>
    )
  }
</BaseLayout>
